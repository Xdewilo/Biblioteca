# Copia este archivo a .env: cp .env.example .env
# .env esta en .gitignore; estos valores son solo para desarrollo local.

# ---- Base de datos ---------------------------------------------------------
DB_NAME=anaquel
DB_USERNAME=anaquel
DB_PASSWORD=anaquel
DB_PORT=5432

# ---- Puertos publicados ----------------------------------------------------
API_PORT=8080
WEB_PORT=5173

# ---- Seguridad -------------------------------------------------------------
# Minimo 32 bytes. En un entorno real: generarlo con `openssl rand -base64 48`.
JWT_SECRET=cambia-este-secreto-de-desarrollo-local-min-32-bytes
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
APP_PUBLIC_URL=http://localhost:5173
# URL base que se publica en Swagger y en docs/openapi.json
API_PUBLIC_URL=http://localhost:8080

# ---- Correo ----------------------------------------------------------------
MAIL_FROM=hola@anaquel.app

# ---- Cuentas de prueba que crea la aplicacion al arrancar -------------------
SEED_ADMIN_EMAIL=admin@anaquel.app
SEED_ADMIN_PASSWORD=Admin123*
SEED_LIBRARIAN_EMAIL=lectura@anaquel.app
SEED_LIBRARIAN_PASSWORD=Admin123*

# ---- Reglas de negocio (ajustables sin recompilar) -------------------------
LOAN_PERIOD_DAYS=14
MAX_LATE_RETURNS=3
LATE_RETURNS_WINDOW_DAYS=90
BLOCK_DURATION_DAYS=7
REMINDER_DAYS_BEFORE=2
# Horas que se le guarda el libro a quien fue notificado antes de pasar el turno
RESERVATION_HOLD_HOURS=48

# ---- Open Library ----------------------------------------------------------
# Si la API no responde en este tiempo, el libro se guarda con los datos manuales.
OPENLIBRARY_TIMEOUT_MS=5000
OPENLIBRARY_MAX_RETRIES=1
OPENLIBRARY_CACHE_TTL_HOURS=24

# ---- Tareas programadas ----------------------------------------------------
# Para ver el recordatorio sin esperar a las 8 a.m.: "0 * * * * *" (cada minuto).
REMINDER_CRON=0 0 8 * * *
OVERDUE_CRON=0 30 8 * * *
EXPIRE_HOLDS_CRON=0 5 * * * *

    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Guarda el token en la variable {{token}} para el resto de la coleccion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.test('rol ADMIN', () => pm.expect(body.user.role).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (BIBLIOTECARIO)",
          "request": {

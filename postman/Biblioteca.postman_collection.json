            },
            "description": "Valida que el libro este DISPONIBLE y que la cuenta no este bloqueada.\nDeja el libro en PRESTADO, calcula dueDate a 14 dias y dispara el correo\nde confirmacion de forma asincrona (revisalo en MailHog).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const loan = pm.response.json();",
                  "pm.collectionVariables.set('loanId', loan.id);",
                  "pm.test('vence en 14 dias', () => {",
                  "  const dias = (new Date(loan.dueDate) - new Date(loan.loanDate)) / 86400000;",
                  "  pm.expect(Math.round(dias)).to.eql(14);",
                  "});"
                ]
              }
            }
          ]
        },
